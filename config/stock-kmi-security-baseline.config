# Security and vendor-module compatibility values extracted from the
# PLK110 stock 6.12.23-android16-5 running kernel config.
# The final generated .config must retain every line exactly.
CONFIG_ARM64_4K_PAGES=y
CONFIG_SHADOW_CALL_STACK=y
CONFIG_CFI_CLANG=y
CONFIG_CFI_ICALL_NORMALIZE_INTEGERS=y
# CONFIG_CFI_PERMISSIVE is not set
CONFIG_MODULES=y
CONFIG_MODVERSIONS=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_PROTECT=y
CONFIG_MODULE_SIG_SHA1=y
CONFIG_MODULE_SIG_HASH="sha1"
CONFIG_RUST=y
CONFIG_ANDROID_BINDER_IPC_RUST=m
CONFIG_ASHMEM_RUST=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_MODULE_ALLOW_BTF_MISMATCH=y
CONFIG_SCHED_CLASS_EXT=y
# CONFIG_RPMB is not set
# CONFIG_TEE is not set
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
