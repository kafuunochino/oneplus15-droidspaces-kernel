+static int shm_ensure_task_state(struct task_struct *task)
+{
+	struct sysv_shm *state;
+
+	if (likely(READ_ONCE(task->sysvshm)))
+		return 0;
+
+	state = kmalloc(sizeof(*state), GFP_KERNEL);
+	if (!state)
+		return -ENOMEM;
+	INIT_LIST_HEAD(&state->shm_clist);
+
+	/*
+	 * newseg() currently calls this only for current, but publish under
+	 * task_lock so exit_shm() and future callers have one clear lifetime
+	 * rule.  Losing a hypothetical race only costs this temporary object.
+	 */
+	task_lock(task);
+	if (!task->sysvshm) {
+		task->sysvshm = state;
+		state = NULL;
+	}
+	task_unlock(task);
+
+	kfree(state);
+	return 0;
+}
