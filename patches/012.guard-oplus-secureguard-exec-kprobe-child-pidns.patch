 		INIT_HLIST_HEAD(&kprobe_table[i]);
 
+	child_pidns_exec_probe_addr =
+		kprobe_lookup_name("do_execveat_common", 0);
+	if (!child_pidns_exec_probe_addr)
+		pr_warn("Failed to resolve do_execveat_common; child PID namespace exec guard is inactive\n");
+
