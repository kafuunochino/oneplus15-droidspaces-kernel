+/*
+ * The OnePlus secure-guard module places a kretprobe on
+ * do_execveat_common().  For a non-leader thread it passes current->tgid,
+ * which is a global PID, to find_task_by_vpid().  In a child PID namespace
+ * that lookup can return NULL, but the closed-source handler immediately
+ * dereferences the result.
+ *
+ * Preserve every probe for Android tasks.  For child-PID-namespace tasks,
+ * skip handlers only at this one exec target while still single-stepping the
+ * original instruction.  This avoids changing find_task_by_vpid() semantics
+ * and leaves unrelated kprobes available to the container.
+ */
+bool __kprobes kprobe_skip_handlers_in_child_pidns(struct kprobe *p)
+{
+	return unlikely(child_pidns_exec_probe_addr &&
+			p->addr == child_pidns_exec_probe_addr &&
+			!task_is_in_init_pid_ns(current));
+}
+NOKPROBE_SYMBOL(kprobe_skip_handlers_in_child_pidns);
+
 /*
  * Blacklist -- list of 'struct kprobe_blacklist_entry' to store info where
  * kprobes can not probe.
@@ -2721,6 +2743,11 @@ static int __init init_kprobes(void)
